NODE_ENV=test
PORT=5001

CLIENT_URL=http://127.0.0.1:5174
CLIENT_URLS=http://127.0.0.1:5174,http://localhost:5174

# Test tooling refuses remote hosts and databases without the _test suffix.
MONGODB_URI=mongodb://connect_test:connect_test_password@127.0.0.1:27018/connect_test?authSource=admin
REDIS_URL=redis://:connect_redis_test@127.0.0.1:6380
REDIS_KEY_PREFIX=connect:test
REDIS_CACHE_ENABLED=true
EXPOSE_CACHE_HEADERS=true

JWT_SECRET=connect-test-only-secret-change-for-shared-environments
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=1
REFRESH_COOKIE_NAME=connect_test_refresh

# Mock values are used by automated tests. Replace only in sandbox runs.
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_test_mock
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RATE_LIMIT_GENERAL=10000
RATE_LIMIT_AUTH=10000
RATE_LIMIT_UPLOAD=10000
RATE_LIMIT_PAYMENT=10000
SOCKET_RATE_WINDOW_MS=10000
SOCKET_RATE_LIMIT=200
SOCKET_MAX_BUFFER_SIZE=1000000

