{
  "name": "connect-dev-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "npm --prefix server run test:unit && npm --prefix client run test:unit",
    "test:integration": "npm --prefix server run test:integration",
    "test:redis": "npm --prefix server run test:redis",
    "test:realtime": "npm --prefix server run test:realtime",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --project=chromium --ui",
    "test:perf": "k6 run tests/performance/smoke.js",
    "test:perf:compare": "node tests/performance/compare.mjs",
    "bench": "npx -y autocannon --version && node tests/performance/benchmark.mjs",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:redis && npm run test:realtime && npm run test:e2e",
    "test:services:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:services:down": "docker compose -f docker-compose.test.yml down -v --remove-orphans",
    "test:seed": "npm --prefix server run test:seed",
    "test:reset": "npm --prefix server run test:reset"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0"
  }
}
